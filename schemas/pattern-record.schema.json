{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgex.local/schemas/v2/pattern-record.schema.json",
  "title": "FORGEX Pattern Record v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["patternId", "version", "status", "problem", "approach", "expectedBenefit", "applicability", "nonApplicability", "evidence", "provenance", "knownTradeoffs", "counterexamples", "reviewTrigger", "createdAt", "updatedAt"],
  "properties": {
    "patternId": { "type": "string", "pattern": "^PAT-[A-Za-z0-9-]+$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": { "enum": ["candidate", "validated", "deprecated"] },
    "problem": { "type": "string", "pattern": "\\S" },
    "approach": { "type": "string", "pattern": "\\S" },
    "expectedBenefit": { "type": "string", "pattern": "\\S" },
    "applicability": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "nonApplicability": { "type": "array", "items": { "type": "string" } },
    "evidence": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["taskId", "outcome"],
      "properties": { "taskId": { "type": "string" }, "outcome": { "type": "string" }, "metric": { "type": "string" } } } },
    "provenance": { "type": "string" },
    "knownTradeoffs": { "type": "array", "items": { "type": "string" } },
    "counterexamples": { "type": "array", "items": { "type": "string" } },
    "reviewTrigger": { "type": "string" },
    "owner": { "type": "string" },
    "replacement": { "type": "string" },
    "createdAt": { "type": "string", "format": "date" },
    "updatedAt": { "type": "string", "format": "date" }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "validated" } } }, "then": { "properties": { "evidence": { "minItems": 2 } } } },
    { "if": { "properties": { "status": { "const": "deprecated" } } }, "then": { "required": ["replacement"] } }
  ]
}
